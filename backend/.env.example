# OpenRouter API Key
# Obtain your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Primary Vision Model (Recommended: ultra-low-cost, lightning fast)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Fallback models cascade (Tries free models, falls back automatically)
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,google/gemini-2.5-flash-lite,qwen/qwen3.8-27b:free

# Maximum upload image size in Megabytes
MAX_IMAGE_SIZE_MB=10
